# /etc/fqrh/fqrh.env —— systemd 用 EnvironmentFile 读取这个文件
# 权限建议：chmod 640 /etc/fqrh/fqrh.env   所有者 root:fqrh
# 这里的变量供 config.json 里 { "env": "变量名" } 的 key 使用。

# ---- 上游 key（按你的 config.json 里的 env 名填）----
# RELAY_API_KEY=sk-xxxxxxxxxxxxxxxx
# RELAY_FREE_KEY=public

# ---- 可选 ----
# Node 22.x 的 node:sqlite 还是实验特性，需要打开这行；Node 24 不需要
# NODE_OPTIONS=--experimental-sqlite

# ---- 注意 ----
# 1) 不要把「客户端 key（clientKeys）」写这里，它属于 config.json
# 2) 不要把本文件提交到 git（.gitignore 已排除 *.env / secrets/）
