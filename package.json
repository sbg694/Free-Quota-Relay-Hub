{
  "name": "fqrh",
  "version": "3.1.4",
  "description": "FQRH — 免费额度中转枢纽：多中转站/免费层统一成一个 OpenAI 兼容出口，带跨协议转换、假 401 缓冲、可写面板",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
